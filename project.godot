; Engine configuration file.
; LEVERAGE — Everyone has leverage on you.
; Third-person open-world crime-action drama. Cinder City.
; Target: Godot 4.7 (Mobile renderer) / XOGOT on iPhone.
; API surface restricted to Godot 4.5-stable-documented features for XOGOT compatibility.

config_version=5

[application]

config/name="LEVERAGE"
config/description="Everyone has leverage on you. A third-person open-world crime-action drama set in Cinder City."
config/version="0.9.0"
config/tags=PackedStringArray("action", "adventure")
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.024, 0.031, 1)
config/icon="res://assets/textures/ui/icon.png"

[audio]

buses/channel_disable_threshold_db=-45.0
buses/channel_disable_frames=2

[autoload]

Bus="*res://scripts/core/bus.gd"
Db="*res://scripts/core/db.gd"
WorldState="*res://scripts/core/world_state.gd"
SaveSystem="*res://scripts/core/save_system.gd"
AudioDirector="*res://scripts/core/audio_director.gd"
Effects="*res://scripts/core/effects.gd"
WorldGen="*res://scripts/world/world_gen.gd"
InteriorManager="*res://scripts/world/interior_manager.gd"
Cutscene="*res://scripts/ui/cutscene.gd"
DialogueUI="*res://scripts/ui/dialogue_ui.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
CallManager="*res://scripts/core/call_manager.gd"
ShopUI="*res://scripts/ui/shop_ui.gd"
PhoneUI="*res://scripts/ui/phone_ui.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation="sensor_landscape"

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font_size=18

