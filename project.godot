; Engine configuration file.
; LEVERAGE — Everyone has leverage on you.
; Third-person open-world crime-action drama. Cinder City.
; Target: Godot 4.7 (Mobile renderer) / XOGOT on iPhone.
;
; XOGOT version floor: 1.7.2 (the first App Store release whose internal engine
; is Godot 4.7; current at time of writing is 1.7.12). Verified against
; github.com/xibbon/XogotDocs @ 4a5a22c, Releases/AppStore.md.
;
; API surface = Godot 4.7. NOTE the split in Xogot's own documentation: the
; RUNTIME engine is 4.7, but the Godot manual BUNDLED with XogotDocs is a
; 4.5-era snapshot (its migrating/ folder stops at upgrading_to_godot_4.5.md,
; with no 4.6 or 4.7 guide). The bundled manual is therefore a guide to
; concepts, NOT an authority on whether a given class or method exists. When an
; API question matters, answer it from the running engine (ClassDB) and not from
; the bundled manual -- restricting this project to 4.5-documented features, as
; an earlier revision of this header instructed, was based on mistaking the
; manual's snapshot age for the engine's version.

config_version=5

[application]

config/name="LEVERAGE"
config/description="Everyone has leverage on you. A third-person open-world crime-action drama set in Cinder City."
config/version="0.9.0"
config/tags=PackedStringArray("action", "adventure")
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.024, 0.031, 1)
config/icon="res://assets/textures/ui/icon.png"

[audio]

buses/channel_disable_threshold_db=-45.0
buses/channel_disable_frames=2

[autoload]

Bus="*res://scripts/core/bus.gd"
Db="*res://scripts/core/db.gd"
Type="*res://scripts/ui/type.gd"
WorldState="*res://scripts/core/world_state.gd"
Difficulty="*res://scripts/core/difficulty.gd"
Progression="*res://scripts/core/progression.gd"
Cinematics="*res://scripts/core/cinematics.gd"
SaveSystem="*res://scripts/core/save_system.gd"
AudioDirector="*res://scripts/core/audio_director.gd"
Effects="*res://scripts/core/effects.gd"
WorldGen="*res://scripts/world/world_gen.gd"
InteriorManager="*res://scripts/world/interior_manager.gd"
Cutscene="*res://scripts/ui/cutscene.gd"
DialogueUI="*res://scripts/ui/dialogue_ui.gd"
MissionManager="*res://scripts/missions/mission_manager.gd"
CallManager="*res://scripts/core/call_manager.gd"
ShopUI="*res://scripts/ui/shop_ui.gd"
PhoneUI="*res://scripts/ui/phone_ui.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
; Xogot's faq.md: "Recent Xogot updates introduce a new default Scale Mode
; called Auto ... this can cause the game to appear zoomed in or stretched. To
; restore the expected appearance, open Project Settings and set Display >
; Window > Scale Mode to Fractional." Godot's own default for this key is
; already "fractional" (core/config/project_settings.cpp:1790), but Xogot
; overrides it, so state it explicitly and let the value travel with the
; project instead of depending on a per-device setting.
window/stretch/scale_mode="fractional"
window/handheld/orientation="sensor_landscape"

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font_size=18

